# ── OMR System — Environment Variables ────────────────────
# Copie este arquivo como .env e ajuste os valores

FLASK_DEBUG=true
PORT=5000

# Security
SECRET_KEY=change-this-to-a-random-secret
JWT_SECRET_KEY=change-this-to-another-random-secret

# Database
DATABASE_URL=sqlite:///omr.db

# Redis (Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
RATELIMIT_ENABLED=true

# ── API v1 / MCP gabaritos_mcp ───────────────────────────
# Chave validada no header X-API-Key (alternativa ao JWT para automação/MCP).
GABARITOS_API_KEY=sua-chave-secreta-local

# Base URL da API consumida pelo servidor MCP.
GABARITOS_API_URL=http://127.0.0.1:5000
