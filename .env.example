# ===========================================
# OpenManus — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then edit .env with your real credentials.
# .env is in .gitignore and will NOT be committed.
# ===========================================

# --- LLM API Keys ---
# Override the api_key set in config/config.toml
# Env vars take precedence over config.toml values (README security note).
# Uncomment and set your key:
# LLM_API_KEY=sk-your-real-api-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here  # preferred for OpenRouter

# --- OpenRouter tracking headers (optional) ---
# Override the default http_referer / x_title sent as HTTP-Referer and
# X-Title headers on OpenAI-compatible requests (recommended by OpenRouter).
# OPENROUTER_HTTP_REFERER=https://github.com/FoundationAgents/OpenManus
# OPENROUTER_X_TITLE=OpenManus

# --- Proxy Settings (optional) ---
# PROXY_USERNAME=your-proxy-username
# PROXY_PASSWORD=your-proxy-password

# --- VNC Password (REQUIRED for sandbox) ---
# Minimum 8 characters. Set a strong password!
# VNC_PASSWORD=your-strong-vnc-password

# --- Daytona Sandbox (optional) ---
# DAYTONA_API_KEY=your-daytona-api-key
